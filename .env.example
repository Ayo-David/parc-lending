NODE_ENV=development
PORT=3005
DATABASE_URL=postgresql:///parc_lending
AUTH_CUSTOMER_URL=http://127.0.0.1:3001
AUTH_JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json
AUTH_JWT_ISSUER=https://auth.parc.invalid
# Outbound service tokens: this service's ES256 key, registered (public half)
# in Auth & Customer SERVICE_CLIENT_KEYS_JSON under "parc-lending".
AUTH_TOKEN_URL=http://127.0.0.1:3001/internal/v1/oauth/token
SERVICE_CLIENT_KEY_ID=parc-lending-1
SERVICE_CLIENT_PRIVATE_KEY_BASE64=replace-with-base64-pkcs8-es256-private-key
TENANT_ADMIN_URL=http://127.0.0.1:3002
LEDGER_URL=http://127.0.0.1:3003
PAYMENT_URL=http://127.0.0.1:3004
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
OUTBOX_TENANT_IDS=
OUTBOX_POLL_MS=1000
